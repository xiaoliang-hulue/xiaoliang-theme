{
  "name": "xiaoliang-theme",
  "version": "1.5.0",
  "description": "小亮主题 — 兼容旧项目的高级设计系统，含海蓝青绿暖金配色、完整动效、浅色/深色双模式与 26 个基础组件",
  "main": "colors_and_type.css",
  "style": "colors_and_type.css",
  "files": [
    "colors_and_type.css",
    "components.css",
    "utilities.css",
    "theme.js",
    "css.json",
    "README.md",
    "SKILL.md",
    "accessibility-report.json",
    "assets/",
    "preview/",
    "ui_kits/",
    "components/",
    "specs/",
    "docs/",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./colors_and_type.css",
    "./css": "./colors_and_type.css",
    "./components": "./components.css",
    "./utilities": "./utilities.css",
    "./tokens": "./css.json",
    "./js": "./theme.js"
  },
  "keywords": [
    "design-system",
    "css-variables",
    "theme",
    "ui-kit",
    "xiaoliang",
    "小亮主题"
  ],
  "author": "小亮 (huluexiaoliang)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/huluexiaoliang/xiaoliang-theme.git"
  },
  "scripts": {
    "build": "node build-tokens.mjs && node extract-components-css.mjs && node build-utilities.mjs",
    "build:tokens": "node build-tokens.mjs",
    "build:components": "node extract-components-css.mjs",
    "build:utilities": "node build-utilities.mjs",
    "build:a11y": "node build-a11y-report.mjs",
    "audit:contrast": "node build-a11y-report.mjs",
    "audit:a11y": "node audit-a11y.mjs",
    "audit:icons": "node audit-icons.mjs",
    "audit:motion": "node audit-motion.mjs",
    "test:visual": "playwright test",
    "audit": "npm run audit:contrast && npm run audit:a11y && npm run audit:icons && npm run audit:motion"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
